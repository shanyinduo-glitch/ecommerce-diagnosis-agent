{
  "purpose": "按渠道对比两期净销售额、订单数、客单价、退款率与访客人次，验证指标口径并定位App渠道下降结构",
  "query": "SELECT i.period,\n       i.channel,\n       SUM(i.net_cents)/100.0 AS net_sales,\n       COUNT(DISTINCT i.order_id) AS order_count,\n       SUM(i.pre_refund_cents)/100.0 AS pre_refund_sales,\n       SUM(i.refund_amount_cents)/100.0 AS refund_amount,\n       SUM(i.gross_amount_cents - i.discount_amount_cents)/100.0 AS gross_after_discount,\n       ROUND(SUM(i.refund_amount_cents)*1.0 / NULLIF(SUM(i.gross_amount_cents - i.discount_amount_cents),0), 6) AS refund_rate,\n       (SUM(i.net_cents)/100.0)/COUNT(DISTINCT i.order_id) AS aov,\n       t.visits\nFROM items i\nLEFT JOIN (SELECT period, channel, SUM(visitors) AS visits FROM traffic GROUP BY period, channel) t\n  ON t.period = i.period AND t.channel = i.channel\nWHERE i.period IN ('control','analysis')\nGROUP BY i.period, i.channel, t.visits\nORDER BY i.channel, i.period",
  "columns": [
    "period",
    "channel",
    "net_sales",
    "order_count",
    "pre_refund_sales",
    "refund_amount",
    "gross_after_discount",
    "refund_rate",
    "aov",
    "visits"
  ],
